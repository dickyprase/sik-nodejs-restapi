generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                   Int     @id @default(autoincrement())
  name                      String?
  username                  String  @unique
  password                  String
  phone                     String  
  telegram_id               Int     
  profile_picture           String

}


