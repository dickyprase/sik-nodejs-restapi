generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model settings {
  setting_id           Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id              Int      @unique(map: "uk_settings_user") @db.UnsignedInt
  salary               Decimal  @default(0.00) @db.Decimal(12, 2)
  attendance_allowance Decimal  @default(0.00) @db.Decimal(10, 2)
  created_at           DateTime @default(now()) @db.DateTime(0)
  updated_at           DateTime @default(now()) @db.DateTime(0)
  users                users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_settings_user")
}

model users {
  user_id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name            String    @db.VarChar(50)
  username        String    @unique(map: "uk_users_username") @db.VarChar(50)
  password        String    @db.VarChar(255)
  number          String?   @unique(map: "uk_users_number") @db.VarChar(25)
  telegram_id     BigInt?   @unique(map: "uk_users_telegram") @db.UnsignedBigInt
  profile_picture String?   @db.VarChar(255)
  created_at      DateTime  @default(now()) @db.DateTime(0)
  updated_at      DateTime  @default(now()) @db.DateTime(0)
  settings        settings?
  website         website[]
}

model website {
  site_id    Int      @id @default(autoincrement()) @db.UnsignedInt
  site_name  String   @db.VarChar(100)
  owner_id   Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
  users      users    @relation(fields: [owner_id], references: [user_id], onDelete: Cascade, map: "fk_website_owner")

  @@index([owner_id], map: "idx_website_owner")
}
